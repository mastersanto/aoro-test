# Copy to .env.local and fill in. Server-side only — none of these may reach the client bundle (constitution Article IV).

# AI assistance (Claude API), used by the /api/assist and /api/recommend routes
ANTHROPIC_API_KEY=

# Required only for identity-linked keys (sk-ant-api03-... issued to a user rather
# than a workspace). Without it the API returns 400 "anthropic-workspace-id is
# required". Find it in the Claude Console URL for your workspace.
# ANTHROPIC_WORKSPACE_ID=

# Optional: override the Claude model used for AI assistance (default: claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# Polymarket's Gamma API (market data) is public — no key needed.
# Bets are signed by the user's wallet client-side (Article III); the server
# holds no Polymarket credentials.
